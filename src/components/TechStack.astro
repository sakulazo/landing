---
import { Icon } from 'astro-icon/components';

const techIcons: Record<string, string> = {
  PHP: 'simple-icons:php',
  Laravel: 'simple-icons:laravel',
  JavaScript: 'simple-icons:javascript',
  MySQL: 'simple-icons:mysql',
  Astro: 'simple-icons:astro',
  FastAPI: 'simple-icons:fastapi',
  Python: 'simple-icons:python',
  'Node.js': 'simple-icons:nodedotjs',
  React: 'simple-icons:react',
  'APIs REST': 'lucide:network',
  Docker: 'simple-icons:docker',
  Linux: 'simple-icons:linux',
  Git: 'simple-icons:git',
  SSH: 'lucide:key-round',
  'Servidores VPS': 'lucide:server',
  OpenCode: 'simple-icons:opencode',
  Ollama: 'simple-icons:ollama',
  'Seguridad IT': 'lucide:shield-check',
  Automatización: 'lucide:zap'
};

const techLinks: Record<string, string> = {
  PHP: 'https://es.wikipedia.org/wiki/PHP',
  Laravel: 'https://es.wikipedia.org/wiki/Laravel',
  JavaScript: 'https://es.wikipedia.org/wiki/JavaScript',
  MySQL: 'https://es.wikipedia.org/wiki/MySQL',
  Astro: 'https://es.wikipedia.org/wiki/Astro_(framework)',
  FastAPI: 'https://en.wikipedia.org/wiki/FastAPI',
  Python: 'https://es.wikipedia.org/wiki/Python',
  'Node.js': 'https://es.wikipedia.org/wiki/Node.js',
  React: 'https://es.wikipedia.org/wiki/React',
  'APIs REST': 'https://es.wikipedia.org/wiki/Transferencia_de_estado_representacional',
  Docker: 'https://es.wikipedia.org/wiki/Docker_(software)',
  Linux: 'https://es.wikipedia.org/wiki/Linux',
  Git: 'https://es.wikipedia.org/wiki/Git',
  SSH: 'https://es.wikipedia.org/wiki/Secure_Shell',
  'Servidores VPS': 'https://es.wikipedia.org/wiki/Servidor_virtual_privado',
  OpenCode: 'https://en.wikipedia.org/wiki/OpenCode',
  Ollama: 'https://en.wikipedia.org/wiki/Ollama',
  'Seguridad IT': 'https://es.wikipedia.org/wiki/Seguridad_inform%C3%A1tica',
  Automatización: 'https://es.wikipedia.org/wiki/Automatizaci%C3%B3n'
};

const categories = [
  {
    name: 'Desarrollo',
    icon: 'lucide:code',
    techs: ['JavaScript', 'Python', 'React', 'Node.js', 'PHP', 'Laravel', 'MySQL', 'FastAPI', 'APIs REST', 'Astro']
  },
  {
    name: 'Infraestructura',
    icon: 'lucide:server',
    techs: ['Docker', 'Linux', 'Git', 'SSH', 'Servidores VPS']
  },
  {
    name: 'Herramientas',
    icon: 'lucide:wrench',
    techs: ['OpenCode', 'Ollama', 'Seguridad IT', 'Automatización']
  }
];
---

<section id="tecnologias" class="section">
  <div class="container">
    <h2 class="section-title">Tecnologías</h2>
    <p class="section-subtitle">Utilizamos las herramientas más robustas del mercado para garantizar resultados de calidad</p>
    <div class="tech-categories">
      {categories.map(category => (
        <div class="tech-category">
          <h3 class="category-name">
            <Icon name={category.icon} class="category-icon" aria-hidden="true" />
            {category.name}
          </h3>
          <div class="tech-tags">
            {category.techs.map(tech => (
              <a class="tech-tag" href={techLinks[tech]} target="_blank" rel="noopener noreferrer">
                <Icon name={techIcons[tech]} class="tech-icon" aria-hidden="true" />
                {tech}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .tech-category {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .tech-category:hover {
    border-color: var(--border-accent);
  }

  .category-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: all 0.3s ease;
  }

  .tech-tag :global(.tech-icon) {
    width: 21px;
    height: 21px;
    flex-shrink: 0;
    color: var(--accent-cyan);
  }

  .tech-tag:hover {
    background: rgba(6, 182, 212, 0.15);
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .tech-categories {
      grid-template-columns: 1fr;
    }
  }
</style>
