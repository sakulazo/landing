---
const categories = [
  {
    name: 'Desarrollo',
    techs: ['PHP', 'Laravel', 'JavaScript', 'MySQL', 'Astro', 'APIs REST']
  },
  {
    name: 'Infraestructura',
    techs: ['Docker', 'Linux', 'Git', 'SSH', 'Servidores VPS']
  },
  {
    name: 'Herramientas',
    techs: ['OpenCode', 'Ollama', 'Seguridad IT', 'Automatización']
  }
];
---

<section id="tecnologias" class="section">
  <div class="container">
    <h2 class="section-title">Tecnologías</h2>
    <p class="section-subtitle">Utilizamos las herramientas más robustas del mercado para garantizar resultados de calidad</p>
    <div class="tech-categories">
      {categories.map(category => (
        <div class="tech-category">
          <h3 class="category-name">{category.name}</h3>
          <div class="tech-tags">
            {category.techs.map(tech => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .tech-category {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .tech-category:hover {
    border-color: var(--border-accent);
  }

  .category-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    padding: 0.5rem 1rem;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.15);
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: all 0.3s ease;
  }

  .tech-tag:hover {
    background: rgba(6, 182, 212, 0.15);
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .tech-categories {
      grid-template-columns: 1fr;
    }
  }
</style>
