---
---

<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <div class="hero-badge">Innovación Tecnológica</div>
    <h1>
      Transformando&nbsp;<span class="hero-title-line-2">
        ideas en&nbsp;<span class="rotating-text" aria-live="polite">
          <span class="rotating-word gradient-text active">soluciones&nbsp;<br class="rotate-br-mobile">digitales</span>
          <span class="rotating-word gradient-text">aplicaciones&nbsp;<br class="rotate-br-mobile">reales</span>
          <span class="rotating-word gradient-text">automatización&nbsp;<br class="rotate-br-mobile">de procesos</span>
          <span class="rotating-caret" aria-hidden="true"></span>
        </span>
      </span>
    </h1>
    <p class="hero-description">
      Estamos especializados en tecnología que ayuda a empresas y profesionales
      a optimizar sus procesos, crear software a medida y gestionar su infraestructura informática.
    </p>
    <div class="hero-buttons">
      <a href="#contacto" class="btn btn-primary">Solicitar información</a>
      <a href="#servicios" class="btn btn-outline">Ver servicios</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-number">15+</span>
        <span class="stat-label">Años de experiencia</span>
      </div>
      <div class="stat">
        <span class="stat-number">100%</span>
        <span class="stat-label">Remoto</span>
      </div>
      <div class="stat">
        <svg class="stat-icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="stat-label">Atención personalizada</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 70px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(6, 182, 212, 0.15), transparent),
      radial-gradient(ellipse 60% 40% at 80% 60%, rgba(59, 130, 246, 0.1), transparent);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid var(--border-accent);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-cyan);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .gradient-text {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rotating-text {
    display: inline-grid;
    grid-template-columns: minmax(0, 1fr);
    vertical-align: baseline;
  }

  .rotating-word {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      filter 0.6s ease;
  }

  .rotating-word.active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .rotate-br-mobile {
    display: none;
  }

  .rotating-caret {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: start;
    margin-left: 100%;
    width: 3px;
    height: 0.9em;
    border-radius: 2px;
    background: var(--accent-cyan);
    animation: caret-blink 1s steps(2, start) infinite;
  }

  @keyframes caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotating-word {
      transition: none;
      opacity: 1;
      transform: none;
      filter: none;
    }

    .rotating-word:not(.active) {
      display: none;
    }
  }

  .hero-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.5rem;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .stat-icon {
    display: block;
    margin: 0 auto 0.5rem;
    color: var(--accent-cyan);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 120px;
    }

    h1 {
      font-size: 2.25rem;
    }

    .hero-title-line-2 {
      display: block;
    }

    .rotating-text {
      display: grid;
      min-height: 2.3em;
    }

    .rotating-word {
      white-space: normal;
    }

    .rotate-br-mobile {
      display: inline;
    }

    .rotating-caret {
      display: none;
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-stats {
      gap: 2rem;
    }
  }

  @media (max-width: 400px) {
    h1 {
      font-size: 1.9rem;
    }
  }
</style>

<script>
  const words = document.querySelectorAll('.rotating-word');
  let index = 0;

  setInterval(() => {
    words[index].classList.remove('active');
    index = (index + 1) % words.length;
    words[index].classList.add('active');
  }, 2600);
</script>
