---
import { Icon } from 'astro-icon/components';
import logoRaw from '../../logo-sakulazo.svg?raw';

const logo = logoRaw
  .replace(/<\?xml[^>]*\?>\s*/i, '')
  .replace(/<!--[\s\S]*?-->\s*/, '')
  .replace('fill:#333333', 'fill:var(--logo-text, var(--text-primary))')
  .replace('fill:#8c8c8c', 'fill:var(--logo-emblem, var(--text-secondary))')
  .replace('fill:#666666', 'fill:var(--logo-tagline, var(--text-muted))')
  .replace('<svg', '<svg class="logo-svg" aria-hidden="true" focusable="false"');
---

<header class="header">
  <nav class="nav">
    <a href="#" class="logo" aria-label="sakulazo.com">
      <Fragment set:html={logo} />
    </a>

    <ul class="nav-links">
      <li><a href="#servicios"><Icon name="lucide:settings" class="nav-icon" aria-hidden="true" />Servicios</a></li>
      <li><a href="#nosotros"><Icon name="lucide:users" class="nav-icon" aria-hidden="true" />Nosotros</a></li>
      <li><a href="#tecnologias"><Icon name="lucide:code" class="nav-icon" aria-hidden="true" />Tecnologías</a></li>
      <li><a href="#contacto"><Icon name="lucide:message-square" class="nav-icon" aria-hidden="true" />Contacto</a></li>
      <li class="nav-theme">
        <label class="theme-switch" title="Cambiar tema">
          <input type="checkbox" class="theme-switch-input" aria-label="Activar modo claro" />
          <Icon name="lucide:sun" class="theme-switch-icon theme-switch-sun" aria-hidden="true" />
          <Icon name="lucide:moon" class="theme-switch-icon theme-switch-moon" aria-hidden="true" />
          <span class="theme-switch-thumb" aria-hidden="true"></span>
        </label>
      </li>
    </ul>

    <div class="nav-actions">
      <label class="theme-switch" title="Cambiar tema">
        <input type="checkbox" class="theme-switch-input" aria-label="Activar modo claro" />
        <Icon name="lucide:sun" class="theme-switch-icon theme-switch-sun" aria-hidden="true" />
        <Icon name="lucide:moon" class="theme-switch-icon theme-switch-moon" aria-hidden="true" />
        <span class="theme-switch-thumb" aria-hidden="true"></span>
      </label>
      <button class="menu-toggle" aria-label="Menú" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const navLinks = document.querySelector('.nav-links');

  toggle?.addEventListener('click', () => {
    navLinks?.classList.toggle('active');
    toggle.classList.toggle('active');
  });

  document.querySelectorAll('.nav-links a').forEach(link => {
    link.addEventListener('click', () => {
      navLinks?.classList.remove('active');
      toggle?.classList.remove('active');
    });
  });

  function applyTheme(theme) {
    const isLight = theme === 'light';
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isLight ? '#f8fafc' : '#0a0f1a');
    document.querySelectorAll('.theme-switch-input').forEach(input => {
      input.checked = isLight;
      input.setAttribute('aria-label', isLight ? 'Activar modo oscuro' : 'Activar modo claro');
    });
  }

  document.querySelectorAll('.theme-switch-input').forEach(input => {
    input.checked = document.documentElement.getAttribute('data-theme') === 'light';
    input.setAttribute('aria-label', input.checked ? 'Activar modo oscuro' : 'Activar modo claro');
    input.addEventListener('change', () => applyTheme(input.checked ? 'light' : 'dark'));
  });

  let resizeTimer;
  window.addEventListener('resize', () => {
    document.documentElement.classList.add('resizing');
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => document.documentElement.classList.remove('resizing'), 150);
  });
</script>

<style>
  :global(html.resizing),
  :global(html.resizing *),
  :global(html.resizing *::before),
  :global(html.resizing *::after) {
    transition: none !important;
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding: 0 clamp(1rem, 2vw, 1.5rem);
    gap: clamp(1rem, 3vw, 2rem);
  }

  .logo {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    color: var(--text-primary);
  }

  :global(.logo-svg) {
    display: block;
    height: var(--logo-size);
    width: auto;
  }

  .nav-links {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 4rem);
    list-style: none;
    white-space: nowrap;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: clamp(1rem, calc(1rem + (100vw - 768px) * 0.001851852), 1.8rem);
    transition: color 0.3s ease;
  }

  .nav-icon {
    display: block;
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
  }

  .nav-links a:hover {
    color: var(--accent-cyan);
  }

  .nav-actions {
    flex: 0 0 auto;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-theme {
    display: none;
  }

  .theme-switch {
    position: relative;
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .theme-switch:hover {
    border-color: var(--border-accent);
  }

  .theme-switch:focus-within {
    border-color: var(--border-accent);
    box-shadow: 0 0 0 2px var(--border-accent);
  }

  .theme-switch-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .theme-switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--accent-gradient);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 0;
  }

  .theme-switch-icon {
    position: relative;
    z-index: 1;
    width: 26px;
    height: 26px;
    padding: 5px;
    box-sizing: border-box;
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .theme-switch-moon {
    color: #ffffff;
  }

  :global(html[data-theme='light']) .theme-switch-thumb {
    transform: translateX(0);
  }

  :global(html[data-theme='light']) .theme-switch-moon {
    color: var(--text-muted);
  }

  :global(html[data-theme='light']) .theme-switch-sun {
    color: #ffffff;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
  }

  .menu-toggle span {
    width: 25px;
    height: 2px;
    background: var(--text-primary);
    transition: all 0.3s ease;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-actions .theme-switch {
      display: none;
    }

    .nav-theme {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: 0.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    .nav-links {
      position: fixed;
      top: var(--header-height);
      left: 15%;
      right: 15%;
      height: auto;
      z-index: 90;
      background: var(--header-bg-glass);
      backdrop-filter: blur(48px) saturate(160%);
      -webkit-backdrop-filter: blur(48px) saturate(160%);
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem;
      gap: 0.5rem;
      border-radius: 16px;
      border: 1px solid var(--border-subtle);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s ease;
      white-space: normal;
    }

    .nav-links a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      border-radius: 10px;
      transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    }

    .nav-links a:hover {
      background: var(--accent-gradient);
      color: #ffffff;
      transform: scale(1.03);
    }

    .nav-links a:hover .nav-icon {
      color: #ffffff;
    }

    .nav-icon {
      display: block;
      color: var(--accent-cyan);
    }

    .nav-links.active {
      transform: translateY(0);
      opacity: 1;
      pointer-events: all;
    }
  }
</style>
