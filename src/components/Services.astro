---
import { Icon } from 'astro-icon/components';

const services = [
  {
    icon: 'lucide:globe',
    title: 'Presencia Digital',
    description: 'Creamos páginas web, portfolios y gestionamos tu presencia online para que tu negocio llegue a más clientes.'
  },
  {
    icon: 'lucide:book-open',
    title: 'Formación Tecnológica',
    description: 'Capacitamos a tu equipo en herramientas digitales, seguridad informática y nuevas tecnologías para aumentar la productividad.'
  },
  {
    icon: 'lucide:wrench',
    title: 'Mantenimiento y Soporte',
    description: 'Nos encargamos del mantenimiento preventivo y correctivo de tus sistemas, resolviendo incidencias de forma rápida y eficiente.'
  },
  {
    icon: 'lucide:code-xml',
    title: 'Software a Medida',
    description: 'Desarrollamos aplicaciones web y sistemas personalizados que se adaptan exactamente a las necesidades de tu negocio.'
  },
  {
    icon: 'lucide:info',
    title: 'Consultoría IT',
    description: 'Analizamos tus necesidades tecnológicas y te ofrecemos asesoramiento experto para tomar las mejores decisiones informáticas.'
  },
  {
    icon: 'lucide:server',
    title: 'Gestión de Servidores',
    description: 'Administración de servidores, correo electrónico, copias de seguridad y aseguramos la disponibilidad de tu infraestructura.'
  }
];
---

<section id="servicios" class="section">
  <div class="container">
    <h2 class="section-title">Nuestros Servicios</h2>
    <div class="services-grid">
      {services.map(service => (
        <div class="service-card">
          <div class="service-icon">
            <Icon name={service.icon} aria-hidden="true" />
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    margin-bottom: 2.5rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .service-card {
    position: relative;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    overflow: hidden;
    cursor: pointer;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(6, 182, 212, 0.05), transparent 50%),
      var(--bg-card);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.9), rgba(59, 130, 246, 0.9));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.15;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .service-card:hover {
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(6, 182, 212, 0.08), transparent 50%),
      var(--bg-card-hover);
    border-color: var(--border-accent);
    transform: translateY(-3px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 2px 6px rgba(0, 0, 0, 0.25),
      0 18px 40px rgba(0, 0, 0, 0.35),
      var(--shadow-glow);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 12px;
    margin-bottom: 1.25rem;
    color: var(--accent-cyan);
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease;
  }

  .service-icon :global(svg) {
    width: 32px;
    height: 32px;
    transition: filter 0.3s ease;
  }

  .service-card:hover .service-icon {
    transform: scale(1.06);
    background: rgba(6, 182, 212, 0.16);
    border-color: rgba(6, 182, 212, 0.45);
  }

  .service-card:hover .service-icon :global(svg) {
    filter: drop-shadow(0 0 6px rgba(6, 182, 212, 0.6));
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .service-card:hover .service-title {
    color: var(--accent-cyan);
  }

  .service-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
