---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'sakulazo | Soluciones Tecnológicas',
  description = 'Ofrecemos servicios de desarrollo web, consultoría IT, formación tecnológica y gestión de infraestructura para empresas y profesionales.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0f1a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const light = stored === 'light' || (!stored && window.matchMedia('(prefers-color-scheme: light)').matches);
          if (light) {
            document.documentElement.setAttribute('data-theme', 'light');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f8fafc');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
